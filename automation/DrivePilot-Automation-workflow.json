        "jsCode": "const rental = $json.body.rental;\nconst customer = $json.body.customer;\nconst vehicle = $json.body.vehicle;\n\nconst pickupDate = new Date(rental.pickupDate).toLocaleDateString();\nconst dropoffDate = new Date(rental.dropoffDate).toLocaleDateString();\n\nconst message = `\n🚗 *New Rental Created — DrivePilot*\n\n👤 *Customer*\n${customer.name}\n${customer.email}\n\n🚘 *Vehicle*\n${vehicle.brand} ${vehicle.name}\n${vehicle.category} • ${vehicle.fuelType} • ${vehicle.transmission}\n\n📍 *Rental Details*\nPickup: ${rental.pickupLocation}\nDrop-off: ${rental.dropoffLocation}\n\n📅 *Dates*\nPickup: ${pickupDate}\nDrop-off: ${dropoffDate}\n\n⏱ *Duration*\n${rental.totalDays} day(s)\n\n💰 *Pricing*\n$${rental.pricePerDay}/day\nTotal: *$${rental.totalAmount}*\n\n📌 *Status*\n${rental.status}\n\n🆔 *Rental ID*\n${rental.id || rental._id || $json.rentalId}\n`;\n\nreturn [\n  {\n    json: {\n      message,\n    },\n  },\n];\n"
